{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "required":["schema_version","round","query","fields","arms","rows","selected","cells","candidates","versions"],
  "properties":{
    "schema_version":{"const":1},"round":{"const":2},"query":{"type":"string","minLength":10},
    "fields":{"type":"array","minItems":22,"maxItems":22,"uniqueItems":true,"items":{"type":"string"}},
    "rows":{"type":"array","minItems":288,"maxItems":288,"items":{"type":"object","required":["run_id","arm","slot","F_FN","F_FP","counts","Y","pi_triggered","video_sha256"],"properties":{"run_id":{"type":"string","pattern":"^f2-r[0-9]{3}-(random|ce|thompson)-[1-4]$"},"arm":{"enum":["random","ce","thompson"]},"slot":{"type":"integer","minimum":1,"maximum":96},"F_FN":{"enum":[0,1]},"F_FP":{"enum":[0,1]},"Y":{"type":"array","minItems":22,"maxItems":22,"items":{"enum":[0,1]}},"pi_triggered":{"type":"boolean"},"video_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}},
    "selected":{"type":"array","minItems":4,"maxItems":4,"items":{"type":"object","required":["id","title","note"]}},
    "arms":{"type":"array","minItems":3,"maxItems":3},"cells":{"type":"array","minItems":48,"maxItems":48,"uniqueItems":true},"candidates":{"type":"array","minItems":6,"maxItems":6,"uniqueItems":true}
  }
}
