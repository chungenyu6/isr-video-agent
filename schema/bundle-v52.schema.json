{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "bundle-v52.schema.json",
 "title": "ISR Video Agent replay bundle, V5.2",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "bundle_version",
  "run_id",
  "attempt",
  "clip_id",
  "seed",
  "live",
  "exported_at",
  "batch",
  "provenance",
  "task",
  "runtime",
  "video",
  "tracking",
  "vehicles",
  "links",
  "possible_links",
  "aliases",
  "votes",
  "appearance",
  "answer",
  "runtime_verifier",
  "posthoc_verifier",
  "run",
  "budget",
  "bundle_kind",
  "query",
  "cases",
  "agent"
 ],
 "$defs": {
  "box": {
   "type": "array",
   "items": {
    "type": "number"
   },
   "minItems": 4,
   "maxItems": 4
  },
  "vec": {
   "type": "array",
   "items": {
    "type": "number"
   },
   "minItems": 2,
   "maxItems": 2
  },
  "span": {
   "type": "array",
   "items": {
    "type": "integer",
    "minimum": 0
   },
   "minItems": 2,
   "maxItems": 2
  },
  "vref": {
   "type": "string",
   "pattern": "^V[0-9]+$"
  },
  "tref": {
   "type": "string",
   "pattern": "^T[0-9]+$"
  },
  "evidence": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "missing_frames",
    "iou",
    "area_ratio",
    "prediction_error_diagonals"
   ],
   "properties": {
    "missing_frames": {
     "type": "number"
    },
    "iou": {
     "type": "number"
    },
    "area_ratio": {
     "type": "number"
    },
    "prediction_error_diagonals": {
     "type": [
      "number",
      "null"
     ]
    }
   }
  },
  "phase": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "start",
    "end",
    "origin",
    "destination",
    "direction",
    "valid",
    "points",
    "vector"
   ],
   "properties": {
    "start": {
     "type": "integer"
    },
    "end": {
     "type": "integer"
    },
    "origin": {
     "type": "string"
    },
    "destination": {
     "type": "string"
    },
    "direction": {
     "type": "string"
    },
    "valid": {
     "type": "boolean"
    },
    "points": {
     "type": "integer"
    },
    "vector": {
     "$ref": "#/$defs/vec"
    }
   }
  },
  "obsref": {
   "type": "string",
   "pattern": "^o[0-9a-f]{32}$"
  },
  "img": {
   "type": "string",
   "pattern": "^frames/o[0-9a-f]{32}-[0-9]+-(full|crop[0-9]*)\\.jpg$"
  }
 },
 "properties": {
  "bundle_version": {
   "const": "5.2"
  },
  "run_id": {
   "type": "string",
   "pattern": "^v52-([0-9]-(nominal|challenging)-r[0-9]-s[0-9]+|diag-B[1-7]-pi)$"
  },
  "attempt": {
   "type": "string",
   "pattern": "^a[0-9]{3}$"
  },
  "clip_id": {
   "type": "string"
  },
  "seed": {
   "type": "integer"
  },
  "live": {
   "const": false
  },
  "exported_at": {
   "type": "string"
  },
  "batch": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "name",
    "created",
    "candidate_revision"
   ],
   "properties": {
    "name": {
     "type": "string"
    },
    "created": {
     "type": "string"
    },
    "candidate_revision": {
     "const": "v5.2"
    }
   }
  },
  "provenance": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "sut_commit",
    "study_commit",
    "service_commit",
    "orchestrator",
    "perception",
    "tracking"
   ],
   "properties": {
    "sut_commit": {
     "type": "string",
     "pattern": "^[0-9a-f]{40}$"
    },
    "study_commit": {
     "type": "string",
     "pattern": "^[0-9a-f]{40}$"
    },
    "service_commit": {
     "type": "string",
     "pattern": "^[0-9a-f]{40}$"
    },
    "orchestrator": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "model",
      "revision",
      "temperature",
      "top_p"
     ],
     "properties": {
      "model": {
       "type": "string"
      },
      "revision": {
       "type": "string"
      },
      "temperature": {
       "type": "number"
      },
      "top_p": {
       "type": "number"
      }
     }
    },
    "perception": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "model",
      "revision",
      "temperature"
     ],
     "properties": {
      "model": {
       "type": "string"
      },
      "revision": {
       "type": "string"
      },
      "temperature": {
       "type": "number"
      }
     }
    },
    "tracking": {
     "oneOf": [
      {
       "type": "null"
      },
      {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "contract",
        "weights_sha256",
        "inference",
        "tracker"
       ],
       "properties": {
        "contract": {
         "type": "string"
        },
        "weights_sha256": {
         "type": "string"
        },
        "inference": {
         "type": "object"
        },
        "tracker": {
         "type": "object"
        }
       }
      }
     ]
    }
   }
  },
  "task": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "question",
    "investigation"
   ],
   "properties": {
    "question": {
     "type": "string"
    },
    "investigation": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "used",
      "statement",
      "instructions",
      "system",
      "tools"
     ],
     "properties": {
      "used": {
       "type": "boolean"
      },
      "statement": {
       "type": "string"
      },
      "instructions": {
       "type": "string"
      },
      "system": {
       "type": "string"
      },
      "tools": {
       "type": "object",
       "additionalProperties": {
        "type": "string"
       }
      }
     }
    }
   }
  },
  "runtime": {
   "type": "object",
   "additionalProperties": {
    "type": [
     "number",
     "string",
     "boolean"
    ]
   }
  },
  "video": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "fps",
    "width",
    "height",
    "nb_frames",
    "duration_sec",
    "proxy"
   ],
   "properties": {
    "fps": {
     "type": "number"
    },
    "width": {
     "type": "integer"
    },
    "height": {
     "type": "integer"
    },
    "nb_frames": {
     "type": "integer"
    },
    "duration_sec": {
     "type": "number"
    },
    "proxy": {
     "type": "string",
     "pattern": "^video/[0-9]-(nominal|challenging)-r[0-9]\\.mp4$"
    }
   }
  },
  "tracking": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "classes",
    "tracks",
    "frames"
   ],
   "properties": {
    "classes": {
     "type": "object",
     "additionalProperties": {
      "type": "string"
     }
    },
    "tracks": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "alias",
       "raw_id",
       "observed",
       "vehicle"
      ],
      "properties": {
       "alias": {
        "$ref": "#/$defs/tref"
       },
       "raw_id": {
        "type": "integer"
       },
       "observed": {
        "$ref": "#/$defs/span"
       },
       "vehicle": {
        "$ref": "#/$defs/vref"
       }
      }
     }
    },
    "frames": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "d",
       "p"
      ],
      "properties": {
       "d": {
        "type": "array",
        "items": {
         "type": "array",
         "items": {
          "type": "number"
         },
         "minItems": 7,
         "maxItems": 7
        }
       },
       "p": {
        "type": "array",
        "items": {
         "type": "array",
         "items": {
          "type": "number"
         },
         "minItems": 5,
         "maxItems": 5
        }
       }
      }
     }
    }
   }
  },
  "vehicles": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "ref",
     "members",
     "observed",
     "frames_observed",
     "attached_unmatched",
     "status",
     "phases",
     "opposing",
     "vote",
     "vote_shared_with",
     "flow",
     "comparison_units",
     "support_units",
     "identity_component"
    ],
    "properties": {
     "ref": {
      "$ref": "#/$defs/vref"
     },
     "members": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/tref"
      },
      "minItems": 1
     },
     "observed": {
      "$ref": "#/$defs/span"
     },
     "frames_observed": {
      "type": "integer"
     },
     "attached_unmatched": {
      "type": "integer"
     },
     "status": {
      "enum": [
       "normal",
       "opposing",
       "stationary",
       "unresolved"
      ]
     },
     "phases": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/phase"
      }
     },
     "opposing": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/span"
      }
     },
     "vote": {
      "oneOf": [
       {
        "$ref": "#/$defs/vec"
       },
       {
        "type": "null"
       }
      ]
     },
     "vote_shared_with": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/vref"
      }
     },
     "flow": {
      "oneOf": [
       {
        "$ref": "#/$defs/vec"
       },
       {
        "type": "null"
       }
      ]
     },
     "comparison_units": {
      "type": "integer"
     },
     "support_units": {
      "type": "integer"
     },
     "identity_component": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/vref"
      }
     }
    }
   }
  },
  "links": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "first",
     "second",
     "kind",
     "evidence"
    ],
    "properties": {
     "first": {
      "$ref": "#/$defs/vref"
     },
     "second": {
      "$ref": "#/$defs/vref"
     },
     "kind": {
      "type": "string"
     },
     "evidence": {
      "$ref": "#/$defs/evidence"
     }
    }
   }
  },
  "possible_links": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "first",
     "second",
     "evidence"
    ],
    "properties": {
     "first": {
      "$ref": "#/$defs/vref"
     },
     "second": {
      "$ref": "#/$defs/vref"
     },
     "evidence": {
      "$ref": "#/$defs/evidence"
     }
    }
   }
  },
  "aliases": {
   "type": "object",
   "additionalProperties": {
    "$ref": "#/$defs/vref"
   }
  },
  "votes": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "vector",
     "vehicles"
    ],
    "properties": {
     "vector": {
      "$ref": "#/$defs/vec"
     },
     "vehicles": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/vref"
      },
      "minItems": 1
     }
    }
   }
  },
  "appearance": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "observation_ref",
     "intent",
     "origin",
     "case_ref",
     "asked_ref",
     "track_ref",
     "vehicle_ref",
     "media",
     "text",
     "finish_reason",
     "truncated",
     "latency_sec",
     "tokens",
     "color_parse"
    ],
    "properties": {
     "observation_ref": {
      "$ref": "#/$defs/obsref"
     },
     "intent": {
      "type": "string"
     },
     "origin": {
      "enum": [
       "host",
       "agent",
       "imported",
       "diagnostic"
      ]
     },
     "case_ref": {
      "type": [
       "string",
       "null"
      ]
     },
     "compare": {
      "type": "boolean"
     },
     "asked_ref": {
      "type": [
       "string",
       "array",
       "null"
      ]
     },
     "track_ref": {
      "$ref": "#/$defs/tref"
     },
     "vehicle_ref": {
      "type": [
       "string",
       "null"
      ]
     },
     "media": {
      "type": "array",
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "frame",
        "targets",
        "full",
        "crops"
       ],
       "properties": {
        "frame": {
         "type": "integer",
         "minimum": 0
        },
        "targets": {
         "type": "array",
         "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
           "track_ref",
           "bbox"
          ],
          "properties": {
           "track_ref": {
            "$ref": "#/$defs/tref"
           },
           "bbox": {
            "$ref": "#/$defs/box"
           }
          }
         }
        },
        "full": {
         "$ref": "#/$defs/img"
        },
        "crops": {
         "type": "array",
         "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
           "path",
           "bounds",
           "track_ref"
          ],
          "properties": {
           "path": {
            "$ref": "#/$defs/img"
           },
           "bounds": {
            "$ref": "#/$defs/box"
           },
           "track_ref": {
            "$ref": "#/$defs/tref"
           }
          }
         }
        }
       }
      }
     },
     "text": {
      "type": "string"
     },
     "finish_reason": {
      "type": "string"
     },
     "truncated": {
      "type": "boolean"
     },
     "latency_sec": {
      "type": [
       "number",
       "null"
      ]
     },
     "tokens": {
      "type": [
       "object",
       "null"
      ]
     },
     "color_parse": {
      "type": [
       "object",
       "null"
      ]
     },
     "step": {
      "type": "integer"
     }
    }
   }
  },
  "answer": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "status",
    "scope",
    "submission",
    "targets",
    "ungrouped_detection_count",
    "unresolved_vehicles",
    "pending_cases"
   ],
   "properties": {
    "status": {
     "type": "string"
    },
    "scope": {
     "type": "string"
    },
    "submission": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "decision",
      "reported_count",
      "colors",
      "count_complete",
      "uncertainty"
     ],
     "properties": {
      "decision": {
       "type": "string"
      },
      "reported_count": {
       "type": [
        "integer",
        "null"
       ]
      },
      "colors": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "count_complete": {
       "type": "boolean"
      },
      "uncertainty": {
       "type": [
        "string",
        "null"
       ]
      }
     }
    },
    "targets": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "vehicle_ref",
       "member_track_refs",
       "color_description",
       "color_observation_ref",
       "source_frame_intervals"
      ],
      "properties": {
       "vehicle_ref": {
        "$ref": "#/$defs/vref"
       },
       "member_track_refs": {
        "type": "array",
        "items": {
         "$ref": "#/$defs/tref"
        }
       },
       "color_description": {
        "type": [
         "string",
         "null"
        ]
       },
       "color_observation_ref": {
        "type": [
         "string",
         "null"
        ]
       },
       "source_frame_intervals": {
        "type": "array",
        "items": {
         "$ref": "#/$defs/span"
        }
       }
      }
     }
    },
    "ungrouped_detection_count": {
     "type": "integer"
    },
    "unresolved_vehicles": {
     "type": "array"
    },
    "pending_cases": {
     "type": "array"
    }
   }
  },
  "runtime_verifier": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "agent_tool_calls",
    "agent_refused",
    "final_answer_check"
   ],
   "properties": {
    "agent_tool_calls": {
     "type": "integer"
    },
    "agent_refused": {
     "type": "integer"
    },
    "final_answer_check": {
     "enum": [
      "pass",
      "not_reached"
     ]
    }
   }
  },
  "posthoc_verifier": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "status",
    "issues",
    "traffic_truth_checked"
   ],
   "properties": {
    "status": {
     "type": "string"
    },
    "issues": {
     "type": "array"
    },
    "traffic_truth_checked": {
     "const": false
    }
   }
  },
  "run": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "wall_sec",
    "terminal_reason",
    "pi_started",
    "investigation_terminal",
    "investigation_sec",
    "tracking_sec",
    "tracking_new_inference",
    "gemma_sec"
   ],
   "properties": {
    "wall_sec": {
     "type": "number"
    },
    "terminal_reason": {
     "type": "string"
    },
    "pi_started": {
     "type": "boolean"
    },
    "investigation_terminal": {
     "type": [
      "string",
      "null"
     ]
    },
    "investigation_sec": {
     "type": [
      "number",
      "null"
     ]
    },
    "tracking_sec": {
     "type": [
      "number",
      "null"
     ]
    },
    "tracking_new_inference": {
     "type": "boolean"
    },
    "gemma_sec": {
     "type": "array",
     "items": {
      "type": "number"
     }
    }
   }
  },
  "budget": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "nemotron",
    "gemma",
    "tool_text"
   ],
   "properties": {
    "nemotron": {
     "type": "object"
    },
    "gemma": {
     "type": "object"
    },
    "tool_text": {
     "type": "object"
    }
   }
  },
  "scorer": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "scorer_version",
    "wrong_way_count",
    "expected_color_multiset",
    "outcome",
    "count_numeric_match",
    "color_multiset_correct",
    "complete_count_correct",
    "partial_color_matches",
    "matching_scope"
   ],
   "properties": {
    "scorer_version": {
     "type": "string"
    },
    "wrong_way_count": {
     "type": "integer"
    },
    "expected_color_multiset": {
     "type": "object"
    },
    "outcome": {
     "type": "string"
    },
    "count_numeric_match": {
     "type": "boolean"
    },
    "color_multiset_correct": {
     "type": "boolean"
    },
    "complete_count_correct": {
     "type": "boolean"
    },
    "partial_color_matches": {
     "type": "integer"
    },
    "matching_scope": {
     "type": "string"
    }
   }
  },
  "review": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "reviewer",
    "independent",
    "count_review",
    "identity_review",
    "color_review",
    "targets"
   ],
   "properties": {
    "reviewer": {
     "const": "coding-agent"
    },
    "independent": {
     "const": false
    },
    "count_review": {
     "type": "string"
    },
    "identity_review": {
     "type": "string"
    },
    "color_review": {
     "type": "string"
    },
    "targets": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "vehicle_ref",
       "object_id",
       "review_frame"
      ],
      "properties": {
       "vehicle_ref": {
        "$ref": "#/$defs/vref"
       },
       "object_id": {
        "type": "string"
       },
       "review_frame": {
        "type": "integer"
       }
      }
     }
    }
   }
  },
  "bundle_kind": {
   "enum": [
    "run",
    "diagnostic"
   ]
  },
  "query": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "task_id",
    "query_id",
    "text",
    "delivered_to",
    "understanding_tested"
   ],
   "properties": {
    "task_id": {
     "const": "wrong_way"
    },
    "query_id": {
     "enum": [
      "Q1",
